{
  "name": "@colophon/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Colophon's design system (D-056): Tailwind CSS v4 tokens in OKLCH and every shadcn-svelte component on Bits UI, in a warm, quiet look: paper and ink, black pill buttons, soft cards, one orange accent.",
  "type": "module",
  "exports": {
    "./styles.css": "./src/lib/styles.css",
    "./utils": "./src/lib/utils.ts",
    "./ui/*": {
      "types": "./src/lib/components/ui/*/index.ts",
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    },
    "./components/*": "./src/lib/components/*"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.62.0",
    "@shadcn-svelte/primitives": "0.0.1",
    "@tanstack/svelte-table": "9.3.1",
    "bits-ui": "2.20.2",
    "cn": "0.5.0",
    "embla-carousel-svelte": "8.6.0",
    "formsnap": "2.1.0",
    "layerchart": "2.9.1",
    "mode-watcher": "1.1.0",
    "paneforge": "1.0.2",
    "shiki": "3.23.0",
    "svelte-sonner": "1.2.1",
    "sveltekit-superforms": "3.0.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "vaul-svelte": "1.0.0-next.7"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "shadcn-svelte": "1.7.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
