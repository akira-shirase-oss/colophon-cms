{
  "name": "@colophon/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Colophon's design system: Material Design 3 tokens generated from one brand seed, and Svelte components on Bits UI primitives (D-011).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "generate": "node scripts/generate-tokens.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@internationalized/date": "3.12.4",
    "bits-ui": "2.20.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@types/node": "24.19.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
