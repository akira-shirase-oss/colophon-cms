  "query": "SELECT p.id, p.slug, p.name, m.role, r.name AS role_name FROM projects p\n         JOIN memberships m ON m.project_id = p.id AND m.identity_id = $1\n         JOIN roles r ON r.project_id = m.project_id AND r.key = m.role\n         WHERE p.id = $2",
