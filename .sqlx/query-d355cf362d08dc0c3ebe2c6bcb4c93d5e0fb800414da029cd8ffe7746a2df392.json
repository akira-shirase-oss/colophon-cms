{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, r.title, r.content\n           FROM entries e\n           JOIN revisions r ON r.id = e.draft_revision_id\n           WHERE e.collection = $1 AND r.content LIKE '%' || $2 || '%'\n           ORDER BY e.updated_at DESC, e.id\n           LIMIT 50",
