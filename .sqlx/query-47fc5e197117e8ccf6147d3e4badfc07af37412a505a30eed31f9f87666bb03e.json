  "query": "SELECT n.project_id, n.role, n.expires_at, i.display_name AS invited_by\n         FROM invitations n JOIN identities i ON i.id = n.invited_by\n         WHERE n.token_hash = $1 AND n.accepted_at IS NULL AND n.revoked_at IS NULL AND n.expires_at > now()",
