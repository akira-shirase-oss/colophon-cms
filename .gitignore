# Backups and their encryption secrets (D-125): the archives are large, local artifacts and
# the passphrase/identity files are the only things that decrypt them.
/backups/
/deploy/backup-passphrase.local
/deploy/backup-age-key.local

# Restore workspaces (D-126): decrypted payloads, stage markers and drill fixtures — all
# local artifacts; the evidence that counts is the JSON under perf/results/.
/restores/

# Throwaway keys from an abandoned test approach; the ID-token tests now generate keys per run.
/crates/colophon-auth/tests/fixtures/

# The demo sites' seed record (D-133): which project the seeded content lives in — per-machine
# state, rewritten by every run of scripts/seed-demo-sites.sh.
/apps/sites/.colophon.json
dist.prev/
dist.next/
