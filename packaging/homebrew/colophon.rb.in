# The Homebrew formula for the colophon CLI, rendered for one release by
# scripts/homebrew-formula.sh from that release's SHA256SUMS. It belongs in the tap
# akira-shirase-oss/homebrew-colophon as Formula/colophon.rb, so that
#   brew install akira-shirase-oss/colophon/colophon
# installs the prebuilt binary (docs/modules/08-cli.md, "Install").
class Colophon < Formula
  desc "Command-line interface for Colophon CMS, the CMS that can prove what it published"
  homepage "https://github.com/akira-shirase-oss/colophon-cms"
  version "@VERSION@"

  on_macos do
    on_arm do
      url "https://github.com/akira-shirase-oss/colophon-cms/releases/download/v@VERSION@/colophon-cli-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/akira-shirase-oss/colophon-cms/releases/download/v@VERSION@/colophon-cli-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/akira-shirase-oss/colophon-cms/releases/download/v@VERSION@/colophon-cli-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/akira-shirase-oss/colophon-cms/releases/download/v@VERSION@/colophon-cli-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "colophon"
  end

  test do
    assert_match "colophon #{version} (commit ", shell_output("#{bin}/colophon --version")
  end
end
