---
export const prerender = true;
import { site, entries, entryPath } from '@colophon/site-kit';
import Base from '../layouts/Base.astro';
import Unseeded from '../components/Unseeded.astro';

const cms = site();
const posts = cms === null ? { items: [], generation: 0 } : await entries(cms, 'posts');

function dateOf(post: (typeof posts.items)[number]): string {
	const value = post.content['published_on'];
	return typeof value === 'string' ? value : '';
}
function tagsOf(post: (typeof posts.items)[number]): string[] {
	const value = post.content['tags'];
	return Array.isArray(value) ? value.filter((tag): tag is string => typeof tag === 'string') : [];
}
---

<Base title="The Draft" generation={posts.generation}>
	{
		cms === null ? (
			<Unseeded />
		) : (
			<>
				<section class="hero">
					<h1>The Draft</h1>
					<p>
						Notes on writing, editing and publishing; every post a published entry in the demo-sites project's{' '}
						<code>posts</code> collection, read anonymously through Colophon's delivery API.
					</p>
				</section>
				<ul class="posts">
					{posts.items.map((post) => (
						<li>
							<a href={`/posts/${entryPath(post)}/`}>
								<span class="meta">
									{dateOf(post)}
									{typeof post.content['author'] === 'string' && ` · ${post.content['author']}`}
								</span>
								<h2>{post.title}</h2>
								{typeof post.content['excerpt'] === 'string' && <p class="excerpt">{post.content['excerpt']}</p>}
							</a>
							<div class="tags">
								{tagsOf(post).map((tag) => (
									<a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
										{tag}
									</a>
								))}
							</div>
						</li>
					))}
				</ul>
			</>
		)
	}
</Base>
