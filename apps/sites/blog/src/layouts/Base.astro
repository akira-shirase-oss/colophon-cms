---
import '../styles/site.css';

interface Props {
	title: string;
	description?: string;
	generation?: number;
}
const { title, description = 'The Draft, a demo blog published through Colophon', generation } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{generation !== undefined && generation > 0 && <meta name="colophon-generation" content={String(generation)} />}
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href="/">The Draft</a>
				<nav class="site-nav">
					<a href="/">Latest posts</a>
					<a href="/members/">Members</a>
				</nav>
			</div>
		</header>
		<main class="wrap">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap">
				{
					generation !== undefined && generation > 0 ? (
						<p>
							Every word on this site was published through <a href="https://github.com/akira-shirase-oss/colophon-cms">Colophon</a> as
							release {generation} of the demo-sites project, and this page names the release it was built from.
						</p>
					) : (
						<p>A Colophon demo site.</p>
					)
				}
			</div>
		</footer>
		{
			generation !== undefined && generation > 0 && (
				<script is:inline>
					// Live updates without a rebuild (D-139): when the CMS announces a release, this page
					// re-reads itself at the new generation and swaps the content in place — scroll kept,
					// no flash. The stream carries only a number, so nothing gated can leak through it.
					(() => {
						const generation = () =>
							Number(document.querySelector('meta[name="colophon-generation"]')?.getAttribute('content')) || 0;
						if (generation() < 1) return;
						const source = new EventSource('/api/live');
						let updating = false;
						source.addEventListener('generation', async (event) => {
							let next;
							try {
								next = JSON.parse(event.data).generation;
							} catch {
								return;
							}
							if (!Number.isInteger(next) || next <= generation() || updating) return;
							updating = true;
							try {
								const response = await fetch(location.pathname + location.search, {
									headers: { 'x-colophon-live': '1' },
									cache: 'no-store'
								});
								if (!response.ok) throw new Error(String(response.status));
								const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
								const main = doc.querySelector('main');
								const footer = doc.querySelector('footer');
								const meta = doc.querySelector('meta[name="colophon-generation"]');
								if (main === null || meta === null) throw new Error('unexpected page');
								document.querySelector('main')?.replaceWith(main);
								if (footer !== null) document.querySelector('footer')?.replaceWith(footer);
								document
									.querySelector('meta[name="colophon-generation"]')
									?.setAttribute('content', meta.getAttribute('content') ?? '');
								document.title = doc.title;
							} catch {
								location.reload();
							} finally {
								updating = false;
							}
						});
					})();
				</script>
			)
		}
	</body>
</html>
