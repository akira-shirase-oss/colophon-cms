{
  "name": "@colophon/site",
  "private": true,
  "version": "0.0.0",
  "description": "Colophon's public website: what it is, what is done and what is planned, the comparison with Strapi and Sanity, the roadmap, the changelog and the build log. Prerendered, self-hosted, nothing from another origin.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "playwright test",
    "import-blog": "node scripts/import-blog.ts"
  },
  "dependencies": {
    "@colophon/site-theme": "0.0.0",
    "@colophon/ui": "0.0.0",
    "@lucide/svelte": "1.62.0",
    "mode-watcher": "1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "markdown-it": "14.3.3",
    "smol-toml": "1.9.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  }
}
