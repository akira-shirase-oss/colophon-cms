{
  "name": "@colophon/docs",
  "private": true,
  "version": "0.0.0",
  "description": "Colophon's documentation site: guides, concepts, references and the design documents, prerendered with mdsvex and searchable with Pagefind, every page labelled implemented, building or planned.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pagefind --site build --output-subdir pagefind",
    "preview": "node scripts/serve.js",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "playwright test"
  },
  "dependencies": {
    "@colophon/ui": "0.0.0",
    "@lucide/svelte": "1.62.0",
    "mode-watcher": "1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "github-slugger": "2.0.0",
    "mdsvex": "0.12.8",
    "pagefind": "1.5.2",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "3.23.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  }
}
