{
  "name": "colophon",
  "private": true,
  "description": "Colophon CMS: the JavaScript workspace (the Studio, the testbed, the UI kit, the renderers and the TypeScript SDK).",
  "workspaces": [
    "packages/*",
    "!packages/cli-npm",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
