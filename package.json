{
  "name": "colophon",
  "private": true,
  "description": "Colophon CMS: the JavaScript workspace (testbed now; the Studio, UI kit and SDK later).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
