# colophon-server settings for the local stack (deploy/compose.yaml). Public, development-only
# values. Scripts load this with `set -a; . deploy/local.env; set +a`.
COLOPHON_LISTEN_ADDR=127.0.0.1:58000
# The application signs in as colophon_app, which can't bypass row-level security.
COLOPHON_DATABASE_URL=postgres://colophon_app:colophon-dev@127.0.0.1:55432/colophon
# Only `colophon admin migrate` uses the migrator (the table owner).
COLOPHON_MIGRATION_DATABASE_URL=postgres://colophon:colophon-dev@127.0.0.1:55432/colophon
COLOPHON_CACHE_URL=redis://:colophon-dev@127.0.0.1:56379
COLOPHON_LOG_FORMAT=pretty
COLOPHON_LOG=info
COLOPHON_DRAIN_DELAY_MS=500
COLOPHON_SHUTDOWN_GRACE_MS=5000
# Sign-in against the local stack's Keycloak (development realm; its secret is public).
COLOPHON_PUBLIC_URL=http://localhost:58000
COLOPHON_OIDC_ISSUER=http://localhost:58080/realms/colophon
COLOPHON_OIDC_CLIENT_ID=colophon-server
COLOPHON_OIDC_CLIENT_SECRET=colophon-dev-client-secret
