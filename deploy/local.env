# colophon-server settings for the local stack (deploy/compose.yaml). Public, development-only
# values. Scripts load this through scripts/local-env.sh, which can point both database URLs at
# another database on the same Postgres (COLOPHON_TEST_DATABASE).
COLOPHON_LISTEN_ADDR=127.0.0.1:58000
# The application signs in as colophon_app, which can't bypass row-level security.
COLOPHON_DATABASE_URL=postgres://colophon_app:colophon-dev@127.0.0.1:55432/colophon
# Only `colophon admin migrate` uses the migrator (the table owner).
COLOPHON_MIGRATION_DATABASE_URL=postgres://colophon:colophon-dev@127.0.0.1:55432/colophon
COLOPHON_CACHE_URL=redis://:colophon-dev@127.0.0.1:56379
COLOPHON_LOG_FORMAT=pretty
COLOPHON_LOG=info
COLOPHON_DRAIN_DELAY_MS=500
COLOPHON_SHUTDOWN_GRACE_MS=5000
COLOPHON_PUBLIC_URL=http://localhost:58000
# Sign-in is the built-in password card (D-146): no COLOPHON_OIDC_* here on purpose — the OIDC
# tests set their own (common::oidc_env) and need the stack's `oidc` compose profile up.
# The uploads' object store: the local stack's Garage (deploy/compose.yaml; public dev keys).
COLOPHON_S3_ENDPOINT=http://127.0.0.1:53900
COLOPHON_S3_REGION=garage
COLOPHON_S3_BUCKET=colophon-dev
COLOPHON_S3_ACCESS_KEY=GK636f6c6f70686f6e2d646576
COLOPHON_S3_SECRET_KEY=636f6c6f70686f6e2d6c6f63616c2d6465762d73332d7365637265742d6b6579
