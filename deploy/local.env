# colophon-server settings for the local stack (deploy/compose.yaml). Public, development-only
# values. Scripts load this with `set -a; . deploy/local.env; set +a`.
COLOPHON_LISTEN_ADDR=127.0.0.1:58000
COLOPHON_DATABASE_URL=postgres://colophon:colophon-dev@127.0.0.1:55432/colophon
COLOPHON_CACHE_URL=redis://:colophon-dev@127.0.0.1:56379
COLOPHON_LOG_FORMAT=pretty
COLOPHON_LOG=info
COLOPHON_DRAIN_DELAY_MS=500
COLOPHON_SHUTDOWN_GRACE_MS=5000
