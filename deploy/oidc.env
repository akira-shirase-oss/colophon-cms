# Optional OIDC provider environment (D-146): source this after deploy/local.env when the compose
# file's `oidc` profile is up and a server should offer single sign-on through Keycloak.
#   docker compose -f deploy/compose.yaml --profile oidc up -d
#   set -a; . deploy/local.env; . deploy/oidc.env; set +a
COLOPHON_OIDC_ISSUER=http://localhost:58080/realms/colophon
COLOPHON_OIDC_CLIENT_ID=colophon-server
COLOPHON_OIDC_CLIENT_SECRET=colophon-dev-client-secret
