# Caddy in front of Colophon on one host (deploy/production/README.md): automatic HTTPS for
# COLOPHON_DOMAIN, everything proxied to the server on loopback. Set COLOPHON_PUBLIC_URL to
# https://$COLOPHON_DOMAIN and COLOPHON_TRUSTED_PROXIES to 127.0.0.1/32 (colophon.env).
{$COLOPHON_DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:58000 {
		# Live updates are server-sent events: pass each event on as it is written.
		flush_interval -1
		# The server closes a connection idle for its header timeout (COLOPHON_HEADER_TIMEOUT_MS,
		# 10 s by default; hyper's header timer also ends idle keep-alives, D-230). Caddy keeps idle
		# upstream connections 2 minutes unless told, and would reuse one the server just closed: a 502
		# for a request it can't retry. Keep them a shorter while than the server does.
		transport http {
			keepalive 5s
		}
	}
}
