# /etc/colophon/colophon.env — Colophon's settings for the systemd unit (deploy/production/colophon.service).
# Not secrets: those are systemd credentials in /etc/colophon/credentials/, read through
# COLOPHON_*_FILE (the unit sets those). Every setting: crates/colophon-server/src/config.rs.

# Behind Caddy (deploy/production/Caddyfile) on the same host: listen on loopback only.
COLOPHON_LISTEN_ADDR=127.0.0.1:58000
COLOPHON_PUBLIC_URL=https://cms.example.com
# The proxy's address, so rate limits count each visitor rather than the proxy.
COLOPHON_TRUSTED_PROXIES=127.0.0.1/32
COLOPHON_LOG_FORMAT=json
COLOPHON_LOG=info

# Uploads: an S3-compatible bucket over https. Garage is tested; DigitalOcean Spaces and
# Cloudflare R2 are not yet verified (README.md, "Object storage").
COLOPHON_S3_ENDPOINT=https://s3.example.com
COLOPHON_S3_REGION=garage
COLOPHON_S3_BUCKET=colophon
COLOPHON_S3_ACCESS_KEY=GK0123456789abcdef01234567

# Sign-in links by email (D-145): uncomment with a key in credentials/resend_api_key and a
# matching LoadCredential= line in the unit.
#COLOPHON_MAIL_PROVIDER=resend
#COLOPHON_MAIL_FROM=Colophon <cms@example.com>
