# /etc/colophon/colophon.env for the S0 droplet (deploy/droplet/DEPLOY.md). Not secrets: those are
# files in /etc/colophon/credentials/ the unit hands the server as systemd credentials. Fill the
# <…> values ON THE DROPLET; every setting is documented in crates/colophon-server/src/config.rs.

# Behind Caddy on the same host, which is behind Cloudflare.
COLOPHON_LISTEN_ADDR=127.0.0.1:58000
# The hostname, in one place: install.sh takes Caddy's site address from it, smoke.sh its domain.
# Another host later: change this line and run install.sh again.
COLOPHON_PUBLIC_URL=https://colophonapp.404human.dev
# Rate limits count visitors: Caddy (loopback) alone is trusted, and it tells the server one
# address, Cloudflare's Cf-Connecting-Ip (the Caddyfile). Not Cloudflare's ranges: a request from
# a Cloudflare address (another account's Worker) could then choose its own client address.
COLOPHON_TRUSTED_PROXIES=127.0.0.1/32
COLOPHON_LOG_FORMAT=json
COLOPHON_LOG=info

# Who may sign up (D-235): invite is the safe default (a sign-up needs a project invitation); open
# (anyone signs up and creates projects within the quotas) is a deliberate choice for a public install.
COLOPHON_REGISTRATION=invite

# Uploads: Cloudflare R2 (S3 API, https). Verify an upload end to end after install (smoke.sh).
COLOPHON_S3_ENDPOINT=https://<r2-account-id>.r2.cloudflarestorage.com
COLOPHON_S3_REGION=auto
COLOPHON_S3_BUCKET=colophon-media
COLOPHON_S3_ACCESS_KEY=<r2-access-key-id>
# The backups' own R2 token (Object Read & Write on colophon-backups only; CREATE.md), read by the
# backup units alone; its secret is credentials/backup_s3_secret_key. The server never holds it.
COLOPHON_BACKUP_S3_ACCESS_KEY=<r2-backup-access-key-id>

# Sign-in links by email (optional for S0): uncomment, put the key in
# credentials/resend_api_key, and add its LoadCredential= line to the unit (DEPLOY.md step 9).
#COLOPHON_MAIL_PROVIDER=resend
#COLOPHON_MAIL_FROM=Colophon <cms@colophon.404human.dev>
