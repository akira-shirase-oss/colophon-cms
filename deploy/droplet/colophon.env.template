# /etc/colophon/colophon.env for the S0 droplet (deploy/droplet/DEPLOY.md). Not secrets: those are
# files in /etc/colophon/credentials/ the unit hands the server as systemd credentials. Fill the
# <…> values ON THE DROPLET; every setting is documented in crates/colophon-server/src/config.rs.

# Behind Caddy on the same host, which is behind Cloudflare.
COLOPHON_LISTEN_ADDR=127.0.0.1:58000
COLOPHON_PUBLIC_URL=https://app.colophon.404human.dev
# Rate limits count visitors, not proxies: Caddy (loopback) and Cloudflare's published ranges.
# cloudflare-ips.sh rewrites this line from https://www.cloudflare.com/ips-v4 and ips-v6.
COLOPHON_TRUSTED_PROXIES=127.0.0.1/32
COLOPHON_LOG_FORMAT=json
COLOPHON_LOG=info

# Uploads: Cloudflare R2 (S3 API, https). Verify an upload end to end after install (smoke.sh).
COLOPHON_S3_ENDPOINT=https://<r2-account-id>.r2.cloudflarestorage.com
COLOPHON_S3_REGION=auto
COLOPHON_S3_BUCKET=colophon-media
COLOPHON_S3_ACCESS_KEY=<r2-access-key-id>

# Sign-in links by email (optional for S0): uncomment, put the key in
# credentials/resend_api_key, and add its LoadCredential= line to the unit (DEPLOY.md step 9).
#COLOPHON_MAIL_PROVIDER=resend
#COLOPHON_MAIL_FROM=Colophon <cms@colophon.404human.dev>
