# The deletion ledger, copied off the droplet daily (deploy/droplet/DEPLOY.md, step 10): Neon's
# point-in-time restore brings the database back to a moment, and this ledger replays what was
# deleted after it (O2, deploy/runbooks/restore.md). Each run writes the whole ledger to its
# high-water mark under deletion-ledger/ in the backups bucket.
#
# Needs D-191 (colophon-cli reads COLOPHON_S3_SECRET_KEY_FILE and refuses plain HTTP off loopback).
[Unit]
Description=Colophon deletion-ledger export to R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
LoadCredential=migration_database_url:/etc/colophon/credentials/migration_database_url
LoadCredential=backup_s3_secret_key:/etc/colophon/credentials/backup_s3_secret_key
EnvironmentFile=/etc/colophon/colophon.env
Environment=COLOPHON_MIGRATION_DATABASE_URL_FILE=%d/migration_database_url
# The backups bucket and the backups' own R2 token (CREATE.md), not the media bucket and token the
# server uses. Set in the command, not with Environment=: EnvironmentFile= overrides Environment=,
# so colophon.env's COLOPHON_S3_BUCKET=colophon-media used to win and the ledger landed in the
# media bucket. Without COLOPHON_BACKUP_S3_ACCESS_KEY in colophon.env, nothing runs.
ExecStart=/bin/sh -c 'export COLOPHON_S3_BUCKET=colophon-backups COLOPHON_S3_SECRET_KEY_FILE=%d/backup_s3_secret_key COLOPHON_S3_ACCESS_KEY="$${COLOPHON_BACKUP_S3_ACCESS_KEY:?no COLOPHON_BACKUP_S3_ACCESS_KEY in colophon.env}"; exec /usr/local/bin/colophon admin ledger-export --s3-key "deletion-ledger/$$(date -u +%%Y-%%m-%%dT%%H%%M%%SZ).jsonl" --json'
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
